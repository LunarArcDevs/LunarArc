{
  "schema_version": 1,
  "quilt_loader": {
    "group": "io.lunararcdevs",
    "id": "lunararc",
    "version": "${version}",
    "metadata": {
      "name": "${project_name}",
      "description": "LunarArc Hybrid Server Core",
      "contributors": {
        "LunarArcDevs": "Owner"
      },
      "contact": {
        "homepage": "https://lunararc.ampznetwork.com",
        "sources": "https://github.com/LunarArcDevs/LunarArc"
      },
      "license": "GPL-3.0-only",
      "icon": "assets/lunararc/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "main": "io.lunararcdevs.lunararc.quilt.LunarArcQuilt"
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=${quilt_loader}"
      },
      {
        "id": "minecraft",
        "versions": "${minecraft}"
      },
      {
        "id": "fabric-api",
        "versions": "*"
      }
    ]
  },
  "mixin": [
    "mixins.lunararc.common.json",
    "mixins.lunararc.quilt.json"
  ],
  "access_widener": "lunararc.accesswidener"
}
